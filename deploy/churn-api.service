[Unit]
Description=Churn Risk API
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/churn-api
Environment=CHURN_THRESHOLD=0.5
ExecStart=/opt/churn-api/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
# lets a normal user listen on port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
